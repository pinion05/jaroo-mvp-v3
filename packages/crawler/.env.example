# @jaroo/crawler local environment template
# Copy to packages/crawler/.env for crawler-specific overrides.
# The root dev scripts also read ../../.env.local and ../../.env.cookie first.

# Server
PORT=3040

# WiseReport Global / CompanyGuide cookies (optional; required for some global routes)
WISEREPORT_GLOBAL_COOKIE_HEADER=
WISEREPORT_GLOBAL_COOKIES_JSON=
WISEREPORT_GLOBAL_COOKIES_FILE=
COMPANY_GLOBAL_COOKIE_HEADER=
COMPANY_GLOBAL_COOKIES_JSON=
COMPANY_GLOBAL_COOKIES_FILE=
WISEREPORT_GLOBAL_COOKIE_FILE=
COMPANY_GLOBAL_COOKIE_FILE=

# US market data providers (optional; missing keys produce provider-unavailable partial results)
POLYGON_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
SEC_EDGAR_USER_AGENT=

# KRX/Kakao dependency credentials (optional; only needed for direct login-backed flows)
KRX_LOGIN_METHOD=
KRX_ID=
KRX_PW=
KAKAO_ID=
KAKAO_PW=

# Supabase crawler cache for DeepScan WiseReport KR slim payloads (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRAWLER_SUPABASE_CACHE_ENABLE=
CRAWLER_SUPABASE_CACHE_FRESH_TTL_MS=
CRAWLER_SUPABASE_CACHE_STALE_TTL_MS=
CRAWLER_SUPABASE_CACHE_TIMEOUT_MS=

# Ecosystem/reference-only keys retained for local alignment
TWELVE_DATA_API_KEY=
DART_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
SUPABASE_ANON_KEY=
