{
  "name": "jaroo-ai-trader",
  "version": "0.1.0",
  "description": "JAROO AI 트레이더 캐릭터 오케스트레이터 — 계좌 매핑·상태 적재·판단 로그 (paper-trade 원장 + 시세 결합, Node.js + node:http + node:sqlite, 런타임 의존성 0)",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-transform-types --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --experimental-transform-types --disable-warning=ExperimentalWarning --max-old-space-size=96 src/index.ts",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  }
}
