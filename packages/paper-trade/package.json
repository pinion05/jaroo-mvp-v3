{
  "name": "jaroo-paper-trade",
  "version": "0.1.0",
  "description": "JAROO 모의투자(매매체결) 시뮬레이터 — 증권사 API 스타일 독립 사이드카 (Node.js + node:http + node:sqlite, 런타임 의존성 0 / cache ZERO / DB fetch only)",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-transform-types --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --experimental-transform-types --disable-warning=ExperimentalWarning --max-old-space-size=96 src/index.ts",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/",
    "typecheck": "tsc -p tsconfig.json"
  }
}
