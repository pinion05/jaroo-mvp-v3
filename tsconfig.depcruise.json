{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2022",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/contracts/src/**/*.ts",
    "packages/crawler/src/**/*.js",
    "packages/deepscan-runtime-core/src/**/*.js",
    "packages/instrument-core/src/**/*.js"
  ]
}
