{
  "name": "jaroo-mvp-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-stack.cjs",
    "build": "npm run build:web",
    "build:instrument-universe": "python scripts/build-instrument-universe.py",
    "start": "npm run start:web",
    "test": "node --test tests/*.test.mjs && npm run test:web:ts && npm run test:crawler && npm run test:instrument-core",
    "test:web:ts": "node scripts/run-web-ts-tests.cjs",
    "verify:screens": "node scripts/verify-screens-browser.cjs",
    "lint": "npm run lint:web",
    "dev:web": "node scripts/with-local-env.cjs next dev",
    "build:web": "node scripts/with-local-env.cjs next build",
    "start:web": "node scripts/with-local-env.cjs next start",
    "lint:web": "eslint src tests eslint.config.mjs next.config.ts",
    "dev:crawler": "node scripts/with-local-env.cjs npm --prefix packages/crawler run dev",
    "start:crawler": "node scripts/with-local-env.cjs npm --prefix packages/crawler run start",
    "check:crawler": "node scripts/with-local-env.cjs npm --prefix packages/crawler run check",
    "test:crawler": "npm --prefix packages/crawler run test",
    "check:instrument-core": "npm --prefix packages/instrument-core run check",
    "test:instrument-core": "npm --prefix packages/instrument-core run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tosspayments/tosspayments-sdk": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ]
}
