  },
  "services": [
    "packages/crawler/src/services/deepscan-kr-evidence.js",
    "packages/crawler/src/services/deepscan-kr-package-adapter.js",
    "packages/crawler/src/services/deepscan-kr-score.js",
    "packages/crawler/src/services/deepscan-kr-copy.js",
    "packages/crawler/src/services/deepscan-payload.js"
  ],
  "tasks": [
    {
      "id": "A",
      "title": "package adapter 추가",
      "outputs": ["ssh invocation", "timeout/retry", "cache", "raw package snapshot"]
    },
    {
      "id": "B",
      "title": "KR evidence extractor 추가",
      "outputs": ["aggregate/slim normalize", "current quote normalize", "evidence packet"]
    },
    {
      "id": "C",
      "title": "deterministic score engine 추가",
      "outputs": ["committee axis score", "hero score", "sellNow decision", "portfolio proxy score"]
    },
    {
      "id": "D",
      "title": "text generator 추가",
      "outputs": ["hero/body", "insights text", "strategy text", "sellNow text", "portfolio caption"]
    },
    {
      "id": "E",
      "title": "canonical composer 교체",
      "outputs": ["real payload", "blockState/sourceRefs/fallback/error"]
