    {
      "id": "F",
      "title": "검증",
      "outputs": ["unit tests", "route tests", "lint/build", "HTTP smoke", "Playwright smoke"]
    }
  ],
  "runtime_rules": {
    "missing_identifier": "400 invalid payload",
    "code_only": {
      "ok": ["hero", "committee", "insights", "strategy"],
      "blocked": ["sellNow", "portfolioSimulation"]
    },
    "full_input": {
      "ok": ["hero", "committee", "insights", "strategy", "sellNow", "portfolioSimulation"]
    }
  }
